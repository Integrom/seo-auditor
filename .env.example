# Приложение
APP_URL=https://seo.example.ru
APP_DEBUG=false

# База данных
DB_HOST=localhost
DB_NAME=seo_auditor
DB_USER=seo_user
DB_PASS=

# Почта (SMTP)
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@example.ru
MAIL_FROM_NAME=SEO Аудитор

# Краулер
CRAWLER_MAX_PAGES=500
CRAWLER_TIMEOUT=10
CRAWLER_DELAY=0.3
CRAWLER_USER_AGENT=SeoAuditorBot/1.0

# Яндекс SmartCaptcha (https://console.cloud.yandex.ru/ → SmartCaptcha)
CAPTCHA_SITEKEY=
CAPTCHA_SECRET=

# Google PageSpeed Insights API — для полевых Core Web Vitals
# Ключ: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Каталог для готовых PDF-отчётов
REPORTS_DIR=/var/www/seo.example.ru/reports

# Context7 MCP (только для локальной разработки)
CONTEXT7_API_KEY=
