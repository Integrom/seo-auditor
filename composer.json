{
    "name": "seo-auditor/app",
    "description": "SEO Аудитор — автоматизированный аудит сайтов",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^8.0",
        "symfony/dom-crawler": "^7.0",
        "symfony/css-selector": "^7.0",
        "mpdf/mpdf": "^8.2",
        "phpmailer/phpmailer": "^7.1",
        "monolog/monolog": "^3.6",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "SeoAuditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SeoAuditor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": "php bin/check_env.php"
    },
    "config": {
        "optimize-autoloader": true
    }
}
